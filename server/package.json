{
  "name": "rtvs-server",
  "version": "0.1.6",
  "description": "Local server for syncing Roblox Studio instances to file system",
  "main": "dist/server.js",
  "scripts": {
    "start": "ts-node src/server.ts",
    "dev": "ts-node src/server.ts",
    "build": "tsc",
    "watch": "tsc --watch",
    "deploy": "ts-node src/plugin-builder/deploy.ts",
    "update": "ts-node src/updater/update.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "roblox",
    "studio",
    "sync",
    "version-control"
  ],
  "author": "",
  "license": "CC-BY-NC-ND-4.0",
  "dependencies": {
    "@types/diff": "^7.0.2",
    "chokidar": "^3.5.3",
    "cors": "^2.8.5",
    "diff": "^8.0.3",
    "express": "^4.18.2",
    "readline-sync": "^1.4.10"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.5",
    "@types/readline-sync": "^1.4.8",
    "@types/supertest": "^6.0.3",
    "jest": "^30.2.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
